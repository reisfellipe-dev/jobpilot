# =============================================================================
# JobPilot - variaveis de ambiente
# Copie para `.env.local` (dev) e configure no painel da Vercel (producao).
# NUNCA coloque segredos reais neste arquivo.
# =============================================================================

# -----------------------------------------------------------------------------
# SUPABASE - publico (exposto ao navegador, por design)
# A anon key e publica; a protecao real vem da Row Level Security.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# SUPABASE - servidor (Vercel Serverless)
# Mesmos valores acima, sem o prefixo VITE_.
# O backend usa a ANON KEY + o JWT do usuario: toda query continua sujeita a RLS.
# Nao existe SERVICE_ROLE_KEY neste projeto - por decisao de seguranca.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# -----------------------------------------------------------------------------
# IA - selecao de provider
# groq   -> usa somente Groq
# nvidia -> usa somente NVIDIA NIM
# auto   -> Groq como principal, NVIDIA como fallback (recomendado)
# -----------------------------------------------------------------------------
AI_PROVIDER=auto

# Permite fallback automatico entre providers em operacoes seguras.
# Operacoes marcadas como "caras" nunca fazem fallback automatico (ver §6).
AI_FALLBACK_ENABLED=true

# -----------------------------------------------------------------------------
# GROQ (provider principal) - https://console.groq.com/keys
# -----------------------------------------------------------------------------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Opcional: sobrescreve a base URL (util para proxies corporativos)
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# Opcional: force "false" se o modelo configurado nao suportar JSON mode
# GROQ_JSON_MODE=auto

# -----------------------------------------------------------------------------
# NVIDIA NIM (provider secundario) - https://build.nvidia.com
# -----------------------------------------------------------------------------
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_JSON_MODE=auto

# -----------------------------------------------------------------------------
# Limites operacionais (opcionais - ha defaults seguros no codigo)
# -----------------------------------------------------------------------------
# Timeout de cada chamada de IA, em milissegundos
AI_TIMEOUT_MS=45000
# Teto de tokens de saida por chamada
AI_MAX_OUTPUT_TOKENS=4000

# =============================================================================
# NAO USAR - proibido por arquitetura:
#   VITE_GROQ_API_KEY      (vazaria a chave para o navegador)
#   VITE_NVIDIA_API_KEY    (idem)
#   ANTHROPIC_API_KEY      (a aplicacao nao depende da Anthropic em runtime)
# =============================================================================
